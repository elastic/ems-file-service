{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "minimumReleaseAge": "14 days",
  "lockFileMaintenance": {
    "enabled": false
  },
  "extends": [
    "github>elastic/renovate-config"
  ],
  "baseBranchPatterns": [
    "master",
    "feature-layers"
  ],
  "labels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "description": "Extract EMS CI agent images from Buildkite pipelines (build-number tags)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.buildkite/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*\"(?<depName>docker\\.elastic\\.co/ci-agent-images/ems/[^:\\s\"]+):(?<currentValue>[^@\\s\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "image: \"{{{depName}}}:{{{newValue}}}@{{{newDigest}}}\""
    }
  ],
  "packageRules": [
    {
      "description": "EMS CI agent images: tag is a build number, not semver; internal image with no release timestamp",
      "matchPackageNames": [
        "docker.elastic.co/ci-agent-images/ems/buildkite-agent-node24",
        "docker.elastic.co/ci-agent-images/ems/playwright"
      ],
      "versioning": "numeric",
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": true
    }
  ]
}
