{
    versions: '>=1'
    production: true
    countryCode: FR
    type: http
    note: Administrative regions of France (post-2016 territorial reform). 13 metropolitan regions (Q36784) + 5 overseas DROMs (Q202216). 18 features total. See sources/fr/README.md for data processing details.
    wikidata: Q36784
    data: https://sophox.org/regions/geojson.json
    attribution: [
      {
        label: {
          en: OpenStreetMap contributors
        }
        url: {
          en: https://www.openstreetmap.org/copyright
        }
      }
      {
        label: {
          en: Elastic Maps Service
        }
        url: {
          en: https://www.elastic.co/elastic-maps-service
        }
      }
    ]
    fieldMapping: [
        {
          type: id
          name: iso_3166_2
          desc: ISO-3166-2 identifier
        }
        {
          type: property
          name: label_en
          desc: Region name (English)
        }
        {
          type: property
          name: label_fr
          desc: Region name (French)
        }
        {
          type: property
          name: insee
          desc: INSEE region code
          skipCopy: true
        }
    ]
    query: {
        sparql:
            '''
            #defaultView:MapRegions
            SELECT
            (if(bound(?id2),?id2,?id1) as ?id)
            ?iso_3166_2 ?label_en ?label_fr ?insee
            WHERE {
              SERVICE <https://query.wikidata.org/sparql> {
              {SELECT
              ?id1
              (SAMPLE(?id2) as ?id2)
              (SAMPLE(?iso_raw) as ?iso_raw)
              (SAMPLE(?label_en) as ?label_en)
              (SAMPLE(?label_fr) as ?label_fr)
              (SAMPLE(?insee) as ?insee)
              WHERE {
                VALUES ?entity { wd:Q142 }

                # P150 = "contains administrative territorial entity"
                ?entity wdt:P150 ?id1 .
                ?id1 wdt:P300 ?iso_raw ;
                     wdt:P31 ?regionType .
                # Q36784 = metropolitan region of France
                # Q202216 = overseas region of France (DROM)
                FILTER(?regionType IN (wd:Q36784, wd:Q202216))

                OPTIONAL { ?id1 rdfs:label ?label_en . FILTER(LANG(?label_en) = "en") }
                OPTIONAL { ?id1 rdfs:label ?label_fr . FILTER(LANG(?label_fr) = "fr") }
                OPTIONAL { ?id1 wdt:P2585 ?insee }
              }
              GROUP BY ?id1
              }
              }
              # Wikidata P300 stores FR-971..FR-976 for overseas regions; remap to ISO 3166-2
              BIND(IF(?iso_raw = "FR-971", "FR-GP",
                   IF(?iso_raw = "FR-972", "FR-MQ",
                   IF(?iso_raw = "FR-973", "FR-GF",
                   IF(?iso_raw = "FR-974", "FR-RE",
                   IF(?iso_raw = "FR-976", "FR-YT",
                   ?iso_raw))))) AS ?iso_3166_2)
            }
            ORDER BY ?iso_3166_2
            '''
    }
    name: france_regions
    legacyIds: [
      France Regions
    ]
    humanReadableName: {
